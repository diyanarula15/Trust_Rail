DATABASE_URL=postgresql+psycopg://trustrail:tr41l_dev_pg_2026@localhost:5434/trustrail
REDIS_URL=redis://localhost:6380/0
SECRET_KEY=change-me
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
ARTIFACT_DIR=./var/artifacts
TRUST_DIR=./var/trust
CERT_LINK_TTL_MINUTES=15
DEFAULT_LOCALE=en
SEBI_CHECK_URL=#            # TODO(owner): set official SEBI Check URL before demo
LLM_ENABLED=false
ANTHROPIC_API_KEY=
CHANNEL_WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# See docs/SETUP_TELEGRAM.md. Ships simulated (scripts/telegram_sim.py) until
# TELEGRAM_BOT_TOKEN is set from @BotFather.
CHANNEL_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Shared secret for the push-based webhook mode (api/webhooks_telegram.py) —
# not needed for the default poll-based mode (scripts/telegram_poll.py).
TELEGRAM_WEBHOOK_SECRET=

# See docs/SETUP_EMAIL.md. Ships simulated (scripts/email_sim.py) until an
# IMAP/SMTP mailbox is configured below.
CHANNEL_EMAIL_ENABLED=false
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_POLL_INTERVAL_SECONDS=30

# See docs/SETUP_SMS.md. Two independent things, both real:
#  - a Twilio number people can text the bot directly (needs all of these)
#  - Trust Circle "Auto-Guard" (below), which needs NONE of this — it scans
#    messages forwarded by an app already on someone's own phone, not
#    anything routed through Twilio.
# Ships simulated (scripts/sms_sim.py) until these are set.
CHANNEL_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Trust Circle: elder<->guardian pairing + automatic alerting, including
# Auto-Guard (scans every message on an enrolled phone with no manual
# "forward this to the bot" step — see docs/SETUP_SMS.md). On by default;
# needs no channel credentials of its own to work over email.
TRUST_CIRCLE_ENABLED=true
CIRCLE_PAIRING_CODE_TTL_MINUTES=15
